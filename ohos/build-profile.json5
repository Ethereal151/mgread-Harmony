{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "__OHOS_CERT_PATH__",
          "keyAlias": "__OHOS_KEY_ALIAS__",
          "keyPassword": "__OHOS_KEY_PASSWORD__",
          "profile": "__OHOS_PROFILE_PATH__",
          "signAlg": "SHA256withECDSA",
          "storeFile": "__OHOS_STORE_FILE__",
          "storePassword": "__OHOS_STORE_PASSWORD__"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compileSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
